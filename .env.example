# 复制为 .env 后填写（.env 已被 .gitignore 排除，不会入库）

# 模型下载镜像（国内加速，可选）
HF_ENDPOINT=https://hf-mirror.com

# vLLM 服务地址（本地部署的 Qwen2.5-7B / 14B-Instruct-AWQ）
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=not-needed
PLANNER_MODEL=Qwen2.5-7B-Instruct-AWQ
CODER_MODEL=Qwen2.5-14B-Instruct-AWQ

# 云端兜底（vLLM 不可用时降级）
FALLBACK_API_KEY=your_api_key_here
FALLBACK_BASE_URL=https://api.deepseek.com/v1
FALLBACK_MODEL=deepseek-chat
